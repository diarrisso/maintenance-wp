#############################################
# Wartung-App - Production Configuration
# Mittwald Hosting
#############################################

APP_NAME="Wartung-App"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Berlin
APP_URL=https://wartung.achtzigdreissig.de

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file

#############################################
# Database - MySQL (Mittwald)
#############################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wartung_app
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

#############################################
# Cache & Session
#############################################
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

#############################################
# Queue
#############################################
QUEUE_CONNECTION=database

#############################################
# Mail Configuration - SMTP
#############################################
MAIL_MAILER=smtp
MAIL_HOST=smtp.mittwald.de
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="wartung@achtzigdreissig.de"
MAIL_FROM_NAME="80/30 GmbH - Wartung"

#############################################
# Logging
#############################################
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

#############################################
# Filesystem
#############################################
FILESYSTEM_DISK=public

#############################################
# Security
#############################################
BCRYPT_ROUNDS=12
